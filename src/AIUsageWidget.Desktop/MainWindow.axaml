<Window x:Class="AIUsageWidget.App.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AIUsageWidget.App.Converters"
        Title="AI Usage Widget"
        Width="{Binding WindowWidth}"
        Height="{Binding WindowHeight}"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Background="Transparent"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="{Binding Settings.ShowInTaskbar}"
        Opacity="{Binding Settings.Opacity}"
        PointerPressed="Window_PointerPressed">
    <Window.Resources>
        <converters:PercentageTextConverter x:Key="PercentageTextConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PercentageWidthConverter x:Key="PercentageWidthConverter" />
</Window.Resources>

    <Viewbox Stretch="Fill">
    <Border Width="{Binding DesignWidth}" Height="{Binding DesignHeight}" CornerRadius="9"
            Background="{StaticResource WidgetBackgroundBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 1 12 0 #47000000"
            Padding="8,6">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Alternar compacto/expandido" Command="{Binding ToggleModeCommand}" />
                <MenuItem Header="Actualizar ahora" Command="{Binding RefreshCommand}" />
                <MenuItem Header="Colocar junto al Dock" Click="DockToTaskbarWidget_Click" />
                <MenuItem Header="Configuracion" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="Ocultar" Command="{Binding HideCommand}" />
            </ContextMenu>
        </Border.ContextMenu>


        <Grid>
            <Grid IsVisible="{Binding Settings.CompactMode}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Border Width="21" Height="21" CornerRadius="5" Background="#D97745" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="M 6,0 L 6,12 M 0.8,3 L 11.2,9 M 0.8,9 L 11.2,3"
                              Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border Grid.Column="1" ToolTip.Tip="{Binding UsageDetails}"
                        Background="#9A25262A"
                        BorderBrush="#2EFFFFFF"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Height="38">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16" />
                            <RowDefinition Height="14" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CompactProgressTrack"
                                    Grid.Column="0"
                                    Height="13"
                                    Background="#303136"
                                    CornerRadius="7"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0">
                                <Border Height="13"
                                        HorizontalAlignment="Left"
                                        Background="{Binding UsageBrush}"
                                        CornerRadius="7">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource PercentageWidthConverter}">
                                            <Binding ElementName="CompactProgressTrack" Path="Bounds.Width" />
                                            <Binding Path="PrimaryUsage" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                            <TextBlock x:Name="PrimaryUsageText" Text="{Binding Snapshot.PrimaryUsagePercentage, Converter={StaticResource PercentageTextConverter}}"
                                       Grid.Column="0"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,5,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding RefreshCommand}" Width="14" Height="14" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Actualizar ahora">
                                    <TextBlock Text="↻" FontSize="7" Foreground="{StaticResource MutedTextBrush}" />
                                </Button>
                                <Button Command="{Binding OpenSettingsCommand}" Width="14" Height="14" Padding="0" Margin="1,0,0,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Configuracion">
                                    <TextBlock Text="⚙" FontSize="7" Foreground="{StaticResource MutedTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,1,0,0">
                            <Ellipse Width="5" Height="5" Fill="{Binding ConnectionBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CompactWeeklyLimitLine}"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Width="62"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Limite semanal" />
                            <TextBlock Text="{Binding CompactResetLine}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding Settings.CompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="{Binding HeaderText}" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding RefreshCommand}" Width="30" Height="26" Padding="0" ToolTip.Tip="Actualizar ahora">
                            <TextBlock Text="↻" FontSize="12" />
                        </Button>
                        <Button Command="{Binding OpenSettingsCommand}" Width="30" Height="26" Padding="0" Margin="8,0,0,0" ToolTip.Tip="Configuracion">
                            <TextBlock Text="⚙" FontSize="12" />
                        </Button>
                        <Button Command="{Binding HideCommand}" Width="30" Height="26" Padding="0" Margin="8,0,0,0" ToolTip.Tip="Ocultar">
                            <TextBlock Text="×" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Uso de sesion" Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SessionUsage, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" Foreground="{Binding UsageBrush}" Margin="0,5,0,2" />
                        <TextBlock x:Name="SessionUsageText" Text="{Binding Snapshot.SessionUsagePercentage, Converter={StaticResource PercentageTextConverter}}" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Uso semanal" Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding WeeklyUsage, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" Foreground="{Binding UsageBrush}" Margin="0,5,0,2" />
                        <TextBlock x:Name="WeeklyUsageText" Text="{Binding Snapshot.WeeklyUsagePercentage, Converter={StaticResource PercentageTextConverter}}" Foreground="White" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ResetLine}" Foreground="White" FontSize="14" />
                        <TextBlock Text="{Binding RequestLine}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding TokenLine}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CostLine}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ModelLine}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" ToolTip.Tip="{Binding UsageDetails}" Background="#18191C" CornerRadius="6" Padding="8" Margin="12,0,0,0">
                        <Polyline Points="{Binding HistoryPoints}" Stroke="{Binding UsageBrush}" StrokeThickness="2" Stretch="Fill" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Viewbox>
</Window>
